# LLM（OpenAI 兼容端点：vLLM / DeepSeek / Qwen 在线均可）
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=sk-local
LLM_MODEL=Qwen2.5-7B-Instruct

# 嵌入模型
EMBED_MODEL=bge-m3

# MCP 插件（JSON 数组；骨架阶段留空即可，见 app/tools/mcp.py）
# 远程 HTTP MCP（url 型）：
# MCP_SERVERS=[{"name":"apollo","url":"https://mcp.apollo.io/mcp","auth":"oauth"},{"name":"clay","url":"https://api.clay.com/v3/mcp","auth":"oauth"}]
# 本地 stdio MCP（command 型，如 AdsPower 浏览器控制）：
# MCP_SERVERS=[{"name":"adspower","command":"npx","args":["local-api-mcp-typescript"]}]
MCP_SERVERS=[]

# 飞书开放平台（自建应用）
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_VERIFICATION_TOKEN=xxxx

# 服务
API_HOST=0.0.0.0
API_PORT=8080
